
---
interface Props {
  number: string;
  title: string;
  category: string;
  image: string;
  alt?: string;
}

const { number, title, category, image, alt = title } = Astro.props;
---

<article class="work-card">
  <a href="#contact" class="work-image">
    <img src={image} alt={alt} loading="lazy" />

    <span class="view">VIEW PROJECT ↗</span>
  </a>

  <div class="work-info">
    <span>{number} / {category}</span>
    <h3>{title}</h3>
  </div>
</article>

<style>
  .work-card {
    min-width: 0;
  }

  .work-image {
    display: block;
    height: 510px;
    overflow: hidden;
    background: #e1ded8;
    position: relative;
  }

  .work-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .work-image:hover img {
    transform: scale(1.035);
  }

  .view {
    position: absolute;
    bottom: 20px;
    right: 20px;
    font-size: 9px;
    letter-spacing: 1px;
    background: #f4f2ed;
    padding: 13px 17px;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .work-image:hover .view {
    opacity: 1;
  }

  .work-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    padding-top: 18px;
  }

  .work-info span {
    color: #77756f;
    font-size: 9px;
    letter-spacing: 1px;
  }

  .work-info h3 {
    font-size: 14px;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .work-image {
      height: 480px;
    }

    .work-info {
      flex-direction: column;
      align-items: start;
      gap: 10px;
    }
  }

  @media (max-width: 420px) {
    .work-image {
      height: 390px;
    }
  }
</style>
