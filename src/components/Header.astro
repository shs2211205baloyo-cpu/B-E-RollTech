---
---

<header class="navbar">
    <a href="#home" class="logo">
        <img src="/rolltech-logo.png" alt="B&E RollTech" />
        <span class="brand-name">B&amp;E <strong>RollTech</strong></span>
    </a>

    <nav>
        <a href="#about">ABOUT</a>
        <a href="#services">SERVICES</a>
        <a href="#projects">PROJECTS ↗</a>
        <a href="#contact">CONTACT ↗</a>
    </nav>

    <div class="nav-actions">
        <span class="nav-label">PHOTO EDITORS / 2026</span>
        <button class="theme-toggle" type="button" aria-label="Switch theme">☾</button>
    </div>
</header>

<style>
    .navbar {
        height: 82px;
        padding: 0 7%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--border);
    }

    .logo {
        display: flex;
        align-items: center;
        height: 54px;
        flex: 0 0 auto;
        gap: 10px;
    }

    .logo img {
        height: 54px;
        width: auto;
        max-width: 180px;
        object-fit: contain;
    }

    .brand-name {
        font-family: "Manrope", sans-serif;
        font-size: 20px;
        font-weight: 500;
        letter-spacing: -1px;
        white-space: nowrap;
        color: var(--text);
    }

    .brand-name strong {
        font-weight: 800;
    }

    :global(:root[data-theme="dark"]) .logo img {
        filter: brightness(1.55) contrast(1.12);
    }

    nav {
        display: flex;
        gap: 32px;
    }

    nav a,
    .nav-label {
        font-size: 10px;
        letter-spacing: 1.2px;
    }

    nav a {
        transition: opacity 0.2s ease;
    }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    nav a:hover {
        opacity: 0.45;
    }

    @media (max-width: 768px) {
        .navbar {
            height: 70px;
            padding: 0 5%;
        }

        nav {
            gap: 14px;
        }

        nav a {
            font-size: 9px;
        }

        .brand-name {
            display: none;
        }

        .nav-label {
            display: none;
        }
    }

    @media (max-width: 420px) {
        nav {
            gap: 9px;
        }

        nav a {
            font-size: 8px;
        }

        .logo,
        .logo img {
            height: 44px;
        }
    }
</style>
